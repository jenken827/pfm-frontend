# Editor config files
.codebuddy
.lingma

# BLAKE3 原生库（Dart FFI 加速）的构建产物：机器相关，不入版本控制
/native/blake3_ffi/target/
/android/app/src/main/jniLibs/

# 构建脚本注入版本号时生成的备份
*.backup
# Android build artifacts
/android/build/
# Kotlin 编译器会话缓存
/android/.kotlin/
# gradle.properties 纳入版本控制：org.gradle.jvmargs 内存上限影响构建成败，
# 各机器需一致（1536M 会在 jetifier 处理 arm64 AAR 时 OOM）

# Lock file (generated, varies by environment)

# 交付安装包（APK / 压缩包等）：不进版本控制，也不许 git add
/release/

# 本地把 pfm_proto 临时指回工作树时用（见 pubspec_overrides.yaml），不入库
pubspec_overrides.yaml
